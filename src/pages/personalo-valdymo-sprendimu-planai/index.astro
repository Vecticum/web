---
import ContactForm from "../../components/home/ContactForm.astro";
import PricingDetails from "../../components/home/PricingDetails.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Testimonials from "../../components/home/Testimonials.astro";

import logoImg from '../../assets/images/logo.webp';

const heroImage = '~/assets/images/planai-hero.webp';

const seoTitle = "Pasirinkite personalo valdymo planą verslui | Vecticum";
const seoDescription = "Lankstūs personalo valdymo sprendimų planai. Efektyvus darbuotojų valdymas, integruoti HR sprendimai, pritaikomi pagal jūsų poreikius.";
const seoImage = '~/assets/images/logo.webp'; // Optional
---

<MainLayout title={seoTitle} description={seoDescription} image={seoImage}>
<!-- ================= HERO ================= -->
<section class="bg-[#3C7099]">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 px-4 sm:px-6 lg:px-8 items-center py-16 md:py-24">
    <!-- Tekstas -->
    <div class="space-y-6 order-2 lg:order-1">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-[#C81E6A]"></span>
        Personalo valdymas
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight">
        Personalo valdymo sprendimų planai
      </h1>
      <p class="text-lg text-white/85 leading-relaxed">
        Lankstūs ir išmanūs Vecticum planai, pritaikyti skirtingo dydžio ir poreikių organizacijoms. Automatizuokite kasdienius personalo procesus, taupykite laiką ir užtikrinkite sklandų darbuotojų patyrimą.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#planai" class="inline-flex items-center gap-2 rounded-full bg-[#C81E6A] px-7 py-3.5 text-white font-semibold hover:bg-[#A51856] transition">
          Peržiūrėti planus
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="#contact" class="inline-block rounded-full bg-white px-7 py-3.5 text-[#3C7099] font-semibold hover:bg-white/90 transition">
          Susisiekti
        </a>
      </div>
    </div>
    <!-- Sistemos vaizdas -->
    <div class="w-full order-1 lg:order-2">
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <!-- Sistemos „langas“ -->
        <div class="rounded-3xl bg-white shadow-2xl overflow-hidden">
          <!-- Viršutinė programos juosta -->
          <div class="flex items-center gap-3 px-4 py-2 bg-gray-100">
            <img src={logoImg.src} alt="Vecticum" class="h-4 w-auto" />
            <i class="fa-solid fa-bars text-[11px] text-gray-400"></i>
            <div class="ml-auto flex items-center gap-3 text-gray-400">
              <span class="text-[11px] font-medium text-gray-500">LT</span>
              <i class="fa-solid fa-expand text-[11px]"></i>
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#C81E6A] text-[10px] font-bold text-white">VE</span>
            </div>
          </div>
          <!-- Programos kūnas: šoninė juosta + turinys -->
          <div class="flex">
            <!-- Šoninė navigacija -->
            <div class="flex w-14 flex-shrink-0 flex-col items-center gap-1 bg-[#2d3748] py-4">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl text-white/50"><i class="fa-solid fa-house"></i></span>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#3C7099] text-white"><i class="fa-solid fa-users"></i></span>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl text-white/50"><i class="fa-solid fa-calendar-days"></i></span>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl text-white/50"><i class="fa-solid fa-file-lines"></i></span>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl text-white/50"><i class="fa-solid fa-gear"></i></span>
            </div>
            <!-- Pagrindinis turinys -->
            <div class="flex-1 min-w-0 p-5">
              <!-- Antraštės eilutė -->
              <div class="mb-5">
                <div class="text-base font-bold text-gray-900">Personalas</div>
                <div class="text-xs text-gray-500">Komandos apžvalga</div>
              </div>
              <!-- Statistikos plytelės -->
              <div class="grid grid-cols-3 gap-2.5 mb-5">
                <div class="rounded-2xl bg-[#3C7099]/[0.06] p-3 text-center">
                  <div class="text-xl font-bold text-[#3C7099]">128</div>
                  <div class="mt-0.5 text-[11px] text-gray-500">Darbuotojų</div>
                </div>
                <div class="rounded-2xl bg-[#C81E6A]/[0.06] p-3 text-center">
                  <div class="text-xl font-bold text-[#C81E6A]">6</div>
                  <div class="mt-0.5 text-[11px] text-gray-500">Atostogose</div>
                </div>
                <div class="rounded-2xl bg-gray-50 p-3 text-center">
                  <div class="text-xl font-bold text-gray-800">4</div>
                  <div class="mt-0.5 text-[11px] text-gray-500">Prašymai</div>
                </div>
              </div>
              <!-- Komandos statusai -->
              <div class="space-y-2.5">
                <div class="flex items-center gap-3 rounded-2xl bg-gray-50 p-2.5">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#3C7099] text-xs font-bold text-white">JK</span>
                  <div class="flex-1 min-w-0 text-sm font-semibold text-gray-800">Jonas Kazlauskas</div>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-600"><span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>Darbe</span>
                </div>
                <div class="flex items-center gap-3 rounded-2xl bg-gray-50 p-2.5">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#C81E6A] text-xs font-bold text-white">AP</span>
                  <div class="flex-1 min-w-0 text-sm font-semibold text-gray-800">Aistė Petraitytė</div>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#3C7099]/10 px-2.5 py-1 text-xs font-semibold text-[#3C7099]"><span class="h-1.5 w-1.5 rounded-full bg-[#3C7099]"></span>Nuotoliniu</span>
                </div>
                <div class="flex items-center gap-3 rounded-2xl bg-gray-50 p-2.5">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#3C7099] text-xs font-bold text-white">MN</span>
                  <div class="flex-1 min-w-0 text-sm font-semibold text-gray-800">Marius Norkus</div>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#C81E6A]/10 px-2.5 py-1 text-xs font-semibold text-[#C81E6A]"><span class="h-1.5 w-1.5 rounded-full bg-[#C81E6A]"></span>Atostogose</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Plaukiojantis ženkliukas -->
        <div class="absolute -bottom-6 -left-4 sm:-left-6 flex items-center gap-3 rounded-2xl bg-white shadow-lg px-5 py-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#C81E6A] text-white"><i class="fa-solid fa-calendar-check"></i></span>
          <div>
            <div class="text-base font-bold text-gray-900">Atostogų kalendorius</div>
            <div class="text-xs text-gray-500">Planavimas realiu laiku</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- HERO PABAIGA -->






<section class="relative py-20 px-6 sm:px-8 bg-white text-gray-900" id="planai">
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-4xl sm:text-5xl text-[#3C7099]">HR sprendimų planai</h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Pasirinkite planą, kuris geriausiai atitinka jūsų organizacijos poreikius – nuo paprastų sprendimų iki visapusiškai konfigūruojamų sistemų.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- BASIC -->
      <div class="rounded-3xl bg-gray-50 border border-gray-200 p-8 shadow-md hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-[#3C7099] mb-2">BASIC</h3>
        <div class="text-4xl font-bold text-[#C81F6A]">€19<span class="text-base font-medium text-gray-500">/mėn.</span></div>
        <p class="mt-4 text-gray-600">Visos personalo savitarnos bazinės funkcijos viename pakete – be papildomos konfigūracijos. Idealu, jei norite greito starto. Rekomenduojama mažoms įmonėms.</p>
        <ul class="mt-6 space-y-4 text-gray-700 text-sm">
          <li>✓ Į planą įtraukta 10 naudotojų</li>
          <li>✓ 2 val. konsultacijos</li>
        </ul>
        <a href="/basic-hr-core-forma" class="mt-8 inline-block bg-[#C81F6A] hover:bg-[#a31755] text-white px-6 py-2 rounded-full font-medium transition">Susisiekti</a>
      </div>

      <!-- ADVANCED -->
      <div class="relative rounded-3xl bg-[#3C7099]/10 border border-[#3C7099] p-8 shadow-lg hover:shadow-xl transition">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#C81F6A] text-white text-xs uppercase font-bold tracking-wider px-4 py-1 rounded-full shadow">Populiariausias</div>
        <h3 class="text-xl font-semibold text-[#3C7099] mb-2">ADVANCED</h3>
        <div class="text-4xl font-bold text-[#C81F6A]">€49<span class="text-base font-medium text-gray-500">/mėn.</span></div>
        <p class="mt-4 text-gray-600">Didesnis kiekis personalo savitarnos funkcijų nei BASIC plane – be papildomos konfigūracijos. Rekomenduojama vidutinėms įmonėms, ieškančioms standartizuoto, bet platesnį funkcijų rinkinį siūlančio sprendimo.</p>
        <ul class="mt-6 space-y-4 text-gray-700 text-sm">
          <li>✓ Į planą įtraukta 10 naudotojų</li>
          <li>✓ 4 val. konsultacijos</li>
        </ul>
        <a href="/advanced-hr-core-forma" class="mt-8 inline-block bg-[#3C7099] hover:bg-[#305d80] text-white px-6 py-2 rounded-full font-medium transition">Susisiekti</a>
      </div>

      <!-- ENTERPRISE -->
      <div class="rounded-3xl bg-gray-50 border border-gray-200 p-8 shadow-md hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-[#3C7099] mb-2">ENTERPRISE</h3>
        <div class="text-4xl font-bold text-[#C81F6A]">Individualus kainos pasiūlymas<span class="text-base font-medium text-gray-500"></span></div>
        <p class="mt-4 text-gray-600">BASIC, ADVANCED ir papildomos ENTERPRISE personalo savitarnos funkcijos, kurios gali būti adaptuotos pagal Užsakovo įmonės tvarkas ir procesus. Galima susikomplektuoti personalo savitarnos sistemą iš 19 atskirų modulių. Rekomenduojama didelėms įmonėms ar individualaus sprendimo ieškančioms įmonėms.</p>
        <ul class="mt-6 space-y-4 text-gray-700 text-sm">
          <li>✓ Nuo 20 naudotojų</li>
          <li>✓ Nuo 4 val. konsultacijos</li>
          <li>Planui taikomas papildomas diegimo mokestis</li>
        </ul>
        <a href="/enterprise-hr-core-forma" class="mt-8 inline-block bg-[#C81F6A] hover:bg-[#a31755] text-white px-6 py-2 rounded-full font-medium transition">Susisiekti</a>
      </div>
  </div>
</section>

<div class="text-center">
  <h3 class="text-3xl sm:text-4xl text-[#3C7099]">Personalo valdymo planų palyginimas</h3>
</div>

  <PricingDetails />
  <ContactForm />

  <Testimonials bgClass="bg-gray-50" />

  <hr>
