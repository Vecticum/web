---
import ContactForm from "../../components/home/ContactForm.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Testimonials from "../../components/home/Testimonials.astro";

const heroImage = "/media/services/gaunamu-saskaitu-valdymas-hero.webp";

const seoTitle = "Sąskaitų valdymo sprendimai verslui | Vecticum";
const seoDescription =
  "Visapusiški sąskaitų valdymo sprendimai verslui: gaunamų sąskaitų srautai, tvirtinimai, avansiniai mokėjimai ir apskaitos integracijos. Užpildykite formą ir gaukite individualų kainos pasiūlymą.";
const seoImage = "~/assets/images/logo.webp";

const solutions = [
  {
    title: "Gaunamų sąskaitų valdymas",
    description: "Gaunamų sąskaitų registravimas, nukreipimas tvirtinimui ir apmokėjimo terminų kontrolė.",
    href: "/gaunamu-saskaitu-valdymas",
    icon: "fa-file-invoice",
  },
  {
    title: "Pirkimų valdymas",
    description: "Užsakymų ir pirkimų inicijavimas, derinimas bei tvirtinimas vienoje vietoje.",
    href: "/pirkimu-valdymas",
    icon: "fa-shopping-cart",
  },
  {
    title: "Avansinės apyskaitos valdymas",
    description: "Avansinių mokėjimų ir išlaidų ataskaitų tvarkymas nuo pateikimo iki tvirtinimo.",
    href: "/avansines-apyskaitos-valdymas",
    icon: "fa-money-check",
  },
  {
    title: "Kelionės lapų valdymas",
    description: "Kelionės lapų pildymas, maršrutų ir kuro sąnaudų apskaita bei tvirtinimas.",
    href: "/keliones-lapu-valdymas",
    icon: "fa-ticket-alt",
  },
  {
    title: "Komandiruočių valdymas",
    description: "Komandiruočių planavimas, biudžetai, dienpinigių skaičiavimas ir ataskaitos.",
    href: "/komandiruociu-valdymas",
    icon: "fa-suitcase",
  },
];

const faqs = [
  {
    q: "Kas yra sąskaitų valdymo sistema?",
    a: "Sąskaitų valdymas – tai procesų ir priemonių visuma, padedanti organizacijoms registruoti, derinti, tvirtinti ir apmokėti gaunamas sąskaitas bei kontroliuoti su jomis susijusias išlaidas. Šiuolaikinis sąskaitų valdymas neapsiriboja failų kaupimu – tai vientisa skaitmeninių srautų sistema, užtikrinanti kontrolę, skaidrumą ir sklandžią apskaitą. Tinkamai įdiegtas sąskaitų valdymas leiždžia įmonei taupyti laiką, mažinti klaidas, kontroliuoti išlaidas ir užtikrinti sklandų finansinių procesų vykdymą.",
  },
  {
    q: "Kokius procesus galima automatizuoti?",
    a: "Gaunamų sąskaitų registravimą ir priskyrimą, tvirtinimo srautus pagal hierarchiją, avansinius mokėjimus ir išlaidų ataskaitas bei biudžetų ir pirkimų kontrolę.",
  },
  {
    q: "Ar galima integruoti su apskaitos sistema?",
    a: "Taip. Prieinama REST API integracija su apskaitos, ERP ar dokumentų valdymo sprendimais, todėl duomenys perduodami automatiškai, be dvigubo suvedimo.",
  },
  {
    q: "Kaip užtikrinamas duomenų saugumas?",
    a: "Vecticum veikia „Google Cloud“ infrastruktūroje. Duomenys perduodami šifruotu TLS ryšiu, laikantis visų BDAR (GDPR) standartų. Prieiga kontroliuojama pagal teises, o veiksmai fiksuojami audito žurnale.",
  },
  {
    q: "Kaip kontroliuojami biudžetai ir terminai?",
    a: "Sistema seka apmokėjimo terminus, tvirtinimo hierarchiją ir biudžetų likučius, todėl išvengiama vėluojančių mokėjimų bei nekontroliuojamų išlaidų.",
  },
  {
    q: "Kodėl kaina individuali?",
    a: "Sąskaitų valdymo sprendimas komplektuojamas iš modulių ir pritaikomas pagal jūsų procesus, naudotojų skaičių bei integracijų poreikį. Todėl tiksli kaina paruošiama tik įvertinus jūsų poreikius – užpildykite formą ir mes pateiksime pasiūlymą.",
  },
];


const benefits = [
  { title: "Efektyvumas", text: "Automatizuoja sąskaitų registravimą, derinimą ir tvirtinimą, sumažina rankinį darbą bei klaidų tikimybę.", icon: "fa-bolt" },
  { title: "Skaidrumas", text: "Suteikia aiškų sąskaitų statusų, atsakingų asmenų ir apmokėjimo terminų matomumą realiu laiku.", icon: "fa-eye" },
  { title: "Kontrolė", text: "Užtikrina biudžetų laikymąsi, tvirtinimo hierarchiją ir savalaikį apmokėjimą.", icon: "fa-sliders" },
  { title: "Teisinė atitiktis", text: "Padeda laikytis apskaitos, saugojimo ir duomenų apsaugos (BDAR) reikalavimų.", icon: "fa-scale-balanced" },
];

const heroPill = "Sąskaitų valdymas";
const heroTitleLead = "Visi sąskaitų valdymo";
const heroTitleAccent = "sprendimai vienoje sistemoje";
const heroLead = "Vecticum apjungia visus sąskaitų valdymo sprendimus – nuo gaunamų sąskaitų srautų ir tvirtinimų iki avansinių mokėjimų, biudžetų kontrolės ir apskaitos integracijų.";
const solutionsTitle = "Kas įeina į sąskaitų valdymą";
const solutionsSubtitle = "Susikomplektuokite sprendimą iš atskirų modulių pagal savo įmonės procesus.";
const heroImageAlt = "Sąskaitų valdymo sistema | VECTICUM";
const planTitle = "Vienas sprendimas – pritaikytas jums";
const planBullets = [
  "Gaunamų sąskaitų registravimas ir tvirtinimo srautai",
  "Avansinių mokėjimų ir išlaidų valdymas",
  "Biudžetų ir pirkimų kontrolė",
  "Sąskaitų archyvas ir audito žurnalas",
  "Integracijos su apskaitos bei ERP sistemomis",
];
const planNote = "Visapusiškas sąskaitų valdymo sprendimas, pritaikomas pagal jūsų įmonės tvarkas ir procesus.";
---

<MainLayout title={seoTitle} description={seoDescription} image={seoImage}>
  <!-- ================= HERO ================= -->
  <section class="bg-[#3C7099]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 px-4 sm:px-6 lg:px-8 items-center py-16 md:py-24">
      <!-- Text -->
      <div class="space-y-6 order-2 lg:order-1">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white">
          <span class="h-1.5 w-1.5 rounded-full bg-[#C81E6A]"></span>
          {heroPill}
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight">
          {heroTitleLead} {heroTitleAccent}
        </h1>
        <p class="text-lg text-white/85 leading-relaxed">
          {heroLead}
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#kaina" class="inline-flex items-center gap-2 rounded-full bg-[#C81E6A] px-7 py-3.5 text-white font-semibold hover:bg-[#A51856] transition">
            Sužinoti kainą
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="#sprendimai" class="inline-block rounded-full bg-white px-7 py-3.5 text-[#3C7099] font-semibold hover:bg-white/90 transition">
            Peržiūrėti sprendimus
          </a>
        </div>
      </div>
      <!-- Sistemos vaizdas -->
      <div class="w-full order-1 lg:order-2">
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <!-- Sistemos „langas“ -->
          <div class="rounded-3xl bg-white shadow-2xl p-6 sm:p-7">
            <div class="flex items-center gap-2 mb-6">
              <span class="h-2.5 w-2.5 rounded-full bg-[#C81E6A]/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#3C7099]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-gray-200"></span>
              <div class="ml-3 flex items-center gap-2 text-sm font-semibold text-gray-700">
                <i class="fa-solid fa-file-invoice-dollar text-[#3C7099]"></i>
                Sąskaitų valdymas
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-center gap-3 rounded-2xl bg-gray-50 p-3.5">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#3C7099]/10 text-[#3C7099]"><i class="fa-solid fa-file-invoice"></i></span>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-gray-800">Sąskaita SF-2041</div>
                  <div class="text-xs text-gray-500">Gauta prieš 1 val.</div>
                </div>
                <span class="rounded-full bg-[#3C7099]/10 px-2.5 py-1 text-xs font-semibold text-[#3C7099]">Gauta</span>
              </div>
              <div class="flex items-center gap-3 rounded-2xl bg-[#3C7099]/[0.06] p-3.5">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#3C7099] text-white"><i class="fa-solid fa-check-double"></i></span>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-gray-800">Sąskaita SF-2038</div>
                  <div class="text-xs text-gray-500">Patvirtinta vadovo</div>
                </div>
                <span class="rounded-full bg-[#3C7099] px-2.5 py-1 text-xs font-semibold text-white">Patvirtinta</span>
              </div>
              <div class="flex items-center gap-3 rounded-2xl bg-gray-50 p-3.5">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#C81E6A]/10 text-[#C81E6A]"><i class="fa-solid fa-money-bill-wave"></i></span>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-gray-800">Sąskaita SF-2030</div>
                  <div class="text-xs text-gray-500">Apmokėta laiku</div>
                </div>
                <span class="rounded-full bg-[#C81E6A]/10 px-2.5 py-1 text-xs font-semibold text-[#C81E6A]">Apmokėta</span>
              </div>
            </div>
          </div>
          <!-- Plaukiojantis ženkliukas -->
          <div class="absolute -bottom-6 -left-4 sm:-left-6 flex items-center gap-3 rounded-2xl bg-white shadow-lg px-5 py-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#C81E6A] text-white"><i class="fa-solid fa-bolt"></i></span>
            <div>
              <div class="text-base font-bold text-gray-900">Automatinė kontrolė</div>
              <div class="text-xs text-gray-500">Nuo gavimo iki apmokėjimo</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= INDIVIDUALIOS KAINOS PASIŪLYMAS ================= -->
  <section id="kaina" class="w-full bg-[#EAF1F7] py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#C81E6A]/10 px-4 py-1.5 text-sm font-semibold text-[#C81E6A]">
        <span class="h-1.5 w-1.5 rounded-full bg-[#C81E6A]"></span>
        Kainodara
      </span>
      <h2 class="mt-5 text-3xl sm:text-4xl font-bold text-gray-900 leading-tight">Norite sužinoti kainą?</h2>
      <p class="mt-4 text-lg text-gray-600">Kaina paruošiama pagal jūsų pasirinktus modulius ir procesus – be jokių paslėptų mokesčių.</p>
    </div>
    <div class="max-w-6xl mx-auto grid lg:grid-cols-5 overflow-hidden rounded-3xl shadow-xl">
      <!-- Kairė: brandinis blokas -->
      <div class="lg:col-span-3 bg-[#3C7099] text-white p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl font-bold leading-tight">{planTitle}</h2>
        <p class="mt-4 text-white/80 leading-relaxed">{planNote}</p>
        <ul class="mt-7 space-y-3">
          {planBullets.map((item) => (
            <li class="flex items-start gap-3 text-white/90">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <!-- Dešinė: kaina + CTA -->
      <div class="lg:col-span-2 bg-white p-8 sm:p-12 flex flex-col justify-center">
        <div class="text-xs font-semibold uppercase tracking-widest text-[#C81E6A]">Kaina</div>
        <div class="mt-3 text-4xl sm:text-5xl font-bold text-gray-900 leading-none">Individualus<br />pasiūlymas</div>
        <p class="mt-4 text-sm leading-relaxed text-gray-500">Priklauso nuo modulių apimties, naudotojų skaičiaus ir integracijų.</p>
        <a href="#contact" class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-[#C81E6A] px-7 py-4 text-white font-semibold hover:bg-[#A51856] transition">
          Užpildyti formą ir sužinoti kainą
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= SPRENDIMAI ================= -->
  <section id="sprendimai" class="w-full bg-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-screen-xl mx-auto">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{solutionsTitle}</h2>
        <p class="mt-4 text-lg text-gray-600">{solutionsSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {solutions.map((s) => (
          <a href={s.href} class="group flex flex-col bg-white p-8 rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 border border-gray-100">
            <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-[#3C7099] text-white mb-6">
              <i class={`fa-solid ${s.icon} text-2xl`}></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 leading-tight">{s.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-gray-600">{s.description}</p>
            <span class="mt-5 inline-flex items-center gap-2 font-semibold text-[#3C7099] group-hover:text-[#C81E6A] transition-colors">
              Plačiau
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= NAUDA ================= -->
  <section class="w-full bg-[#EAF1F7] py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="max-w-screen-xl mx-auto grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
      <!-- Tekstas + priežastys -->
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-[#C81E6A]/10 px-4 py-1.5 text-sm font-semibold text-[#C81E6A]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#C81E6A]"></span>
          Kodėl Vecticum
        </span>
        <h2 class="mt-5 text-3xl sm:text-4xl font-bold text-gray-900 leading-tight">Kodėl verta rinktis Vecticum</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">Patikimas partneris, padedantis valdyti sąskaitas efektyviai, skaidriai ir kontroliuojamai – nuo gavimo iki apmokėjimo.</p>
        <div class="mt-10 space-y-6">
          {benefits.map((b) => (
            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-[#3C7099] text-white shadow-sm">
                <i class={`fa-solid ${b.icon} text-lg`}></i>
              </span>
              <div>
                <h3 class="text-lg font-bold text-gray-900">{b.title}</h3>
                <p class="mt-1 text-gray-600 leading-relaxed">{b.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <!-- Vizualas: plaukiojančios kortelės -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="rounded-3xl bg-white shadow-xl border border-gray-100 p-6 sm:p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="h-2.5 w-2.5 rounded-full bg-[#C81E6A]/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#3C7099]/50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-gray-200"></span>
            <div class="ml-2 h-2.5 w-28 rounded-full bg-gray-100"></div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 rounded-2xl border border-gray-100 p-3.5">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#3C7099]/10 text-[#3C7099]"><i class="fa-solid fa-file-invoice"></i></span>
              <div class="flex-1 space-y-1.5"><div class="h-2.5 w-32 rounded-full bg-gray-200"></div><div class="h-2 w-20 rounded-full bg-gray-100"></div></div>
              <span class="rounded-full bg-[#3C7099]/10 px-2.5 py-1 text-xs font-semibold text-[#3C7099]">Gauta</span>
            </div>
            <div class="flex items-center gap-3 rounded-2xl border border-[#3C7099]/20 bg-[#3C7099]/[0.06] p-3.5">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#3C7099] text-white"><i class="fa-solid fa-check-double"></i></span>
              <div class="flex-1 space-y-1.5"><div class="h-2.5 w-28 rounded-full bg-[#3C7099]/30"></div><div class="h-2 w-16 rounded-full bg-[#3C7099]/20"></div></div>
              <span class="rounded-full bg-[#3C7099] px-2.5 py-1 text-xs font-semibold text-white">Patvirtinta</span>
            </div>
            <div class="flex items-center gap-3 rounded-2xl border border-gray-100 p-3.5">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[#C81E6A]/10 text-[#C81E6A]"><i class="fa-solid fa-money-bill-wave"></i></span>
              <div class="flex-1 space-y-1.5"><div class="h-2.5 w-24 rounded-full bg-gray-200"></div><div class="h-2 w-14 rounded-full bg-gray-100"></div></div>
              <span class="rounded-full bg-[#C81E6A]/10 px-2.5 py-1 text-xs font-semibold text-[#C81E6A]">Apmokėta</span>
            </div>
          </div>
        </div>
        <!-- Plaukiojantis ženkliukas -->
        <div class="absolute -bottom-6 -left-4 sm:-left-6 flex items-center gap-3 rounded-2xl bg-white shadow-lg border border-gray-100 px-5 py-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#3C7099] text-white"><i class="fa-solid fa-shield-halved"></i></span>
          <div>
            <div class="text-base font-bold text-gray-900">BDAR</div>
            <div class="text-xs text-gray-500">Saugūs duomenys</div>
          </div>
        </div>
        <!-- Dekoratyvinis akcentas -->
        <div class="absolute -top-8 -right-8 -z-10 h-40 w-40 rounded-full bg-[#C81E6A]/10 blur-2xl"></div>
      </div>
    </div>
  </section>

  <ContactForm
    formSource="Sąskaitų valdymo sprendimų puslapis – kainos užklausa"
    heading="Sužinokite sąskaitų valdymo kainą"
    subheading="Užpildykite formą ir pateiksime individualų sąskaitų valdymo sprendimo kainos pasiūlymą pagal jūsų poreikius."
  />

  <Testimonials bgClass="bg-[#EAF1F7]" />

  <!-- ================= DUK ================= -->
  <section class="bg-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 text-center mb-12">Dažniausiai užduodami klausimai</h2>
      <div class="space-y-4">
        {faqs.map((item) => (
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
            <details class="group">
              <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-semibold text-gray-900 hover:bg-gray-50 transition-colors duration-200">
                <span>{item.q}</span>
                <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed border-t border-gray-100">
                <p class="pt-4">{item.a}</p>
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
