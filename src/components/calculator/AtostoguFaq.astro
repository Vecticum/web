---
const faqs = [
  {
    q: "Kiek atostogų dienų priklauso darbuotojui?",
    a: "Pagal Darbo kodeksą minimali kasmetinių atostogų trukmė yra 20 darbo dienų, kai dirbama penkias dienas per savaitę, arba 24 darbo dienos, kai dirbama šešias dienas per savaitę. Tai atitinka keturias kalendorines savaites per metus.",
  },
  {
    q: "Ar atostogų trukmė gali būti ilgesnė už minimalią?",
    a: "Taip. Darbo kodeksas numato pailgintas ir papildomas atostogas – pavyzdžiui, už ilgametį darbo stažą, neįgaliesiems ar darbuotojams, auginantiems vaikų. Ilgesnę atostogų trukmę darbdavys taip pat gali nustatyti darbo ar kolektyvinėje sutartyje.",
  },
  {
    q: "Ką daryti su nepanaudotomis atostogomis keičiant darbą?",
    a: "Nutraukiant darbo sutartį už visas nepanaudotas kasmetines atostogas darbdavys privalo išmokėti piniginę kompensaciją. Nepanaudotos atostogos nepersikelia pas naują darbdavį – naujoje darbovietėje jos pradedamos kaupti iš naujo.",
  },
  {
    q: "Kokios papildomos atostogos priklauso tėvams ar neįgaliesiems?",
    a: "Neįgaliems darbuotojams suteikiama 25 darbo dienų kasmetinių atostogų. Darbuotojai, auginantys vaikų, turi teisę į papildomas poilsio dienas per mėnesį, o vieniems auginantiems vaiką iki 14 metų ar neįgalų vaiką iki 18 metų kasmetinės atostogos yra pailginamos.",
  },
  {
    q: "Kaip skaičiuojamos atostogų dienos dirbant ne pilnu etatu?",
    a: "Dirbant ne visą darbo dieną ar savaitę, kasmetinių atostogų trukmė nemažinama – priklauso tiek pat darbo dienų kaip ir dirbant visu etatu. Skiriasi tik atostoginių dydis, nes jis skaičiuojamas pagal darbuotojo vidutinį darbo užmokestį.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
});
---

<section class="not-prose my-12">
  <h2 class="mb-6 text-2xl sm:text-3xl font-bold text-gray-900">
    Dažniausiai užduodami klausimai
  </h2>

  <div class="space-y-3">
    {
      faqs.map((f) => (
        <details class="group rounded-xl border border-gray-200 bg-white shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-base font-semibold text-gray-900">
            {f.q}
            <i class="fa-solid fa-chevron-down text-sm text-[#3C7099] transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-gray-600">
            {f.a}
          </div>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={faqSchema} />
</section>
