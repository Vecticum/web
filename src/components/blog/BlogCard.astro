---
import FormattedDate from "../FormattedDate.astro";
import { getPublicImageSize } from "~/utils/imageSize";

const { post } = Astro.props;
const heroSize = await getPublicImageSize(post.data.heroImage);
---

<article class="group bg-white rounded-xl shadow-md overflow-hidden transition-all hover:shadow-xl">
  <div class="aspect-video w-full overflow-hidden">
    <img
      alt={post.data.title}
      src={post.data.heroImage}
      width={heroSize?.width}
      height={heroSize?.height}
      class="w-full h-full object-cover transition group-hover:scale-105"
    />
  </div>

  <div class="p-5">
    <a href={post.data.customUrl || `/${post.id}/`}>
      <h3 class="text-lg font-semibold text-gray-900 group-hover:text-[#3C7099] transition">
        {post.data.title}
      </h3>
    </a>

    <p class="mt-3 line-clamp-3 text-sm text-gray-600 leading-relaxed">
      {post.data.description}
    </p>

    <a
      href={post.data.customUrl || `/${post.id}/`}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[#3C7099] transition group-hover:gap-2"
    >
      Skaityti daugiau
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  </div>
</article>
